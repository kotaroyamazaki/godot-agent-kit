# Per-game values read by godot-kit. Optional: without this file the folder name is used as GAME_ID.
GAME_ID=__GAME_ID__
GAME_TITLE="__GAME_TITLE__"
# Only if the Godot project is not at the repository root (e.g. client)
#GAME_DIR=.
# Only if this game needs a specific Godot binary (e.g. tools/godot)
#GODOT_CMD=godot
