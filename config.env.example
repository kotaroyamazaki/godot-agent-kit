# Copy to ~/.config/godot-kit/config.env, or run `godot-kit setup`. Every line is optional.

# Godot 4 binary, if `godot` is not on PATH
#GODOT_KIT_GODOT=/Applications/Godot.app/Contents/MacOS/Godot

# Where `godot-kit new` creates games (default: the current folder)
#GODOT_KIT_GAMES_DIR=~/games

# Language of the files in a new game: en or ja
#GODOT_KIT_LANG=en

# A file you already keep API keys in (lines like OPENAI_API_KEY=... or export OPENAI_API_KEY=...).
# Keys are looked up in: the environment, ~/.config/godot-kit/secrets.env, then this file.
#GODOT_KIT_SECRETS_FILE=~/.secrets.env

# Image models
#GODOT_KIT_IMAGE_MODEL=gpt-image-2.5-flare
#GODOT_KIT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
